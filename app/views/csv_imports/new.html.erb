<h1 class="text-2xl font-bold text-slate-900">Import CSV</h1>
<p class="mt-2 text-sm text-slate-600">Upload a CSV file from your bank to import transactions.</p>

<% needing_format = @accounts.reject(&:importable?) %>

<%= form_with url: csv_imports_path, method: :post, multipart: true, data: { turbo: false, controller: "import-format" }, class: "mt-8 max-w-lg space-y-6" do |f| %>
  <div>
    <label for="account_id" class="block text-sm font-medium text-slate-700">Account</label>
    <select name="account_id" id="account_id" required
            data-import-format-target="account"
            data-action="change->import-format#accountChanged"
            class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm">
      <option value="">Select an account...</option>
      <% @accounts.each do |account| %>
        <option value="<%= account.id %>"
                data-format="<%= account.import_format %>"
                data-format-label="<%= account.import_format_label %>"
                <%= "disabled" unless account.importable? %>
                <%= "selected" if account.importable? && params[:account_id].to_s == account.id.to_s %>>
          <%= account.name %><%= " — no import format set" unless account.importable? %>
        </option>
      <% end %>
    </select>
    <% if @accounts.empty? %>
      <p class="mt-1 text-sm text-amber-600">
        No accounts found. <%= link_to "Create an account", new_account_path, class: "underline" %> first.
      </p>
    <% elsif needing_format.any? %>
      <p class="mt-1 text-xs text-amber-600">
        Not selectable until an import format is set:
        <% needing_format.each_with_index do |account, index| %><%= ", " if index > 0 %><%= link_to account.name, edit_account_path(account), class: "underline" %><% end %>.
      </p>
    <% end %>
  </div>

  <div>
    <span class="block text-sm font-medium text-slate-700">Import format</span>
    <p data-import-format-target="label" class="mt-1 text-sm text-slate-900">
      <span class="text-slate-500">Select an account to see its import format.</span>
    </p>
    <p class="mt-1 text-xs text-slate-500">
      The format belongs to the account, so there is nothing to choose here. Change it on the account itself.
    </p>
  </div>

  <div>
    <label for="csv_file" class="block text-sm font-medium text-slate-700">CSV File</label>
    <input type="file" name="csv_file" id="csv_file" accept=".csv,text/csv" required
           class="mt-1 block w-full text-sm text-slate-500
                  file:mr-4 file:py-2 file:px-4
                  file:rounded file:border-0
                  file:text-sm file:font-semibold
                  file:bg-emerald-50 file:text-emerald-700
                  hover:file:bg-emerald-100">
  </div>

  <div class="rounded-md bg-slate-100 p-4">
    <h3 class="text-sm font-medium text-slate-700" data-import-format-target="referenceHeading">Supported Formats</h3>
    <dl class="mt-2 space-y-3 text-sm">
      <% CsvImports::Format.all.each do |format| %>
        <div data-import-format-target="entry" data-format-key="<%= format.key %>">
          <dt class="font-medium text-slate-600"><%= format.label %></dt>
          <dd class="text-slate-500">
            CSV with columns: <%= format.columns %><br>
            Example: <code class="bg-white px-1"><%= format.example %></code>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div>
    <button type="submit" class="inline-flex justify-center rounded-md border border-transparent bg-emerald-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
      Import Transactions
    </button>
    <%= link_to "Cancel", transactions_path, class: "ml-3 text-sm text-slate-600 hover:text-slate-900" %>
  </div>
<% end %>
