<h1 class="text-2xl font-bold text-slate-900">Import Results</h1>
<p class="mt-2 text-sm text-slate-600">
  Import completed for <strong><%= @account.name %></strong>
  using <strong><%= @account.import_format_label %></strong>.
</p>

<div class="mt-8 max-w-2xl">
  <dl class="grid grid-cols-3 gap-4 text-sm">
    <div class="rounded-md bg-emerald-50 p-3">
      <dt class="text-emerald-700">Imported</dt>
      <dd class="text-2xl font-bold text-emerald-900"><%= @result.imported_count %></dd>
    </div>
    <div class="rounded-md bg-amber-50 p-3">
      <dt class="text-amber-700">Already held</dt>
      <dd class="text-2xl font-bold text-amber-900"><%= @result.skipped_count %></dd>
    </div>
    <div class="rounded-md bg-red-50 p-3">
      <dt class="text-red-700">Errors</dt>
      <dd class="text-2xl font-bold text-red-900"><%= @result.error_count %></dd>
    </div>
  </dl>

  <% if @result.derived_checkpoint %>
    <div class="mt-6 rounded-md border border-emerald-300 bg-emerald-50 p-4">
      <h2 class="text-lg font-semibold text-emerald-800">Opening checkpoint derived</h2>
      <p class="mt-1 text-sm text-emerald-900">
        The account held nothing, so the balance standing before the file's earliest row was read
        off the bank's own balance column and recorded as a checkpoint:
        <strong><%= humanized_money_with_symbol(@result.derived_checkpoint.balance) %></strong>
        at close on <strong><%= l(@result.derived_checkpoint.closed_on, format: :long) %></strong>.
      </p>
      <p class="mt-2 text-xs text-emerald-700">
        It is marked derived: it is probably right, but nobody has yet held it against a statement.
        <%= link_to "Check it", edit_checkpoint_path(@result.derived_checkpoint), class: "underline" %>.
      </p>
    </div>
  <% end %>

  <% if @result.suggested_checkpoint %>
    <div class="mt-6 rounded-md border border-slate-300 bg-slate-50 p-4">
      <h2 class="text-lg font-semibold text-slate-800">Closing balance available</h2>
      <p class="mt-1 text-sm text-slate-700">
        This file's last day closes at
        <strong><%= humanized_money_with_symbol(Money.new(@result.suggested_checkpoint.balance_cents, :cad)) %></strong>
        on <strong><%= l(@result.suggested_checkpoint.closed_on, format: :long) %></strong>.
        Recording it as a checkpoint confines any future discrepancy to the period after it.
      </p>
      <p class="mt-3">
        <%= link_to "Record this checkpoint",
                    new_account_checkpoint_path(@account,
                                                closed_on: @result.suggested_checkpoint.closed_on,
                                                balance_cents: @result.suggested_checkpoint.balance_cents),
                    class: "inline-flex rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white" %>
      </p>
      <p class="mt-2 text-xs text-slate-500">
        Offered, not recorded. Nothing is written to the balance without an explicit instruction.
      </p>
    </div>
  <% end %>

  <% if @audit.discrepancies.any? %>
    <div class="mt-6">
      <h2 class="text-lg font-semibold text-amber-800">Intervals that do not balance</h2>
      <p class="mt-1 text-sm text-slate-600">
        Each difference is contained within the two checkpoints named, not spread across the account.
      </p>
      <div class="mt-3 space-y-3">
        <% @audit.discrepancies.each do |interval| %>
          <div class="rounded-md border border-amber-300 bg-amber-50 p-4">
            <p class="text-sm font-medium text-amber-800">
              <%= interval.label %> is off by
              <%= humanized_money_with_symbol(Money.new(interval.discrepancy_cents.abs, :cad)) %>
            </p>
            <p class="mt-1 text-xs text-amber-700">
              <%= pluralize(interval.transaction_count, "transaction") %> reach
              <%= humanized_money_with_symbol(Money.new(interval.expected_cents, :cad)) %>,
              against a checkpoint of
              <%= humanized_money_with_symbol(Money.new(interval.actual_cents, :cad)) %>.
            </p>
          </div>
        <% end %>
      </div>
      <p class="mt-3 text-sm">
        <%= link_to "Review #{@account.name}", @account, class: "text-emerald-600 underline" %>
        to close a gap with an adjustment.
      </p>
    </div>
  <% end %>

  <% if @result.skipped_duplicates.any? %>
    <div class="mt-6">
      <h2 class="text-lg font-semibold text-amber-800">Rows Already Held</h2>
      <p class="mt-1 text-sm text-slate-600">
        Rows are matched by occurrence: for a given date, amount, description and entry type, a file
        holding several contributes only the ones the account does not already have. These were
        already there. Two coffees on one day still import as two.
      </p>
      <div class="mt-3 overflow-x-auto rounded-md border border-amber-200">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="bg-amber-50 text-left text-amber-800">
              <th class="px-3 py-2 font-medium">Date</th>
              <th class="px-3 py-2 font-medium">Description</th>
              <th class="px-3 py-2 font-medium text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amber-100 bg-white">
            <% @result.skipped_duplicates.first(50).each do |dup| %>
              <tr class="text-slate-700">
                <td class="px-3 py-2 whitespace-nowrap"><%= dup.occurred_on.strftime("%Y-%m-%d") %></td>
                <td class="px-3 py-2"><%= dup.description %></td>
                <td class="px-3 py-2 text-right whitespace-nowrap">
                  <span class="<%= dup.entry_type == :expense ? 'text-red-600' : 'text-emerald-600' %>">
                    <%= dup.entry_type == :expense ? '-' : '+' %><%= number_to_currency(dup.amount_cents / 100.0) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @result.skipped_duplicates.count > 50 %>
          <p class="bg-amber-50 px-3 py-2 text-sm text-slate-500">... and <%= @result.skipped_duplicates.count - 50 %> more</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @result.errors.any? %>
    <div class="mt-6">
      <h2 class="text-lg font-semibold text-red-800">Errors</h2>
      <ul class="mt-2 list-disc list-inside space-y-1 text-sm text-red-600">
        <% @result.errors.first(20).each do |error| %>
          <li><%= error %></li>
        <% end %>
        <% if @result.errors.count > 20 %>
          <li class="text-slate-500">... and <%= @result.errors.count - 20 %> more errors</li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @csv_import %>
    <p class="mt-6 text-xs text-slate-500">
      <%= @csv_import.filename %> was kept (<span class="font-mono"><%= @csv_import.short_digest %></span>),
      so this account can be rebuilt from its own sources.
    </p>
  <% end %>

  <div class="mt-8 flex gap-4">
    <%= link_to "View Transactions", transactions_path, class: "inline-flex justify-center rounded-md border border-transparent bg-emerald-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2" %>
    <%= link_to "Import More", new_csv_import_path, class: "inline-flex justify-center rounded-md border border-slate-300 bg-white py-2 px-4 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2" %>
  </div>
</div>
